# Build output
build/*
!build/.gitkeep

# IDE and temporary files
.vscode/
.idea/
*.user
*.suo
*.pdb

# Compiled binaries and libraries in compile/
compile/bin/*
!compile/bin/.gitkeep
compile/libs/*
!compile/libs/.gitkeep
compile/venv/

history/

# Runtime session and playback cache
cache/*
!cache/.gitkeep
